#!/bin/sh
# Fixed MAC fallback (if the DT local-mac-address lost against U-Boot)
# and LED triggers for RJ45 link/activity and onboard work LEDs. Runs before S41dhcpcd.

MAC=d6:af:ce:d0:c4:c3
DEV=eth0

case "$1" in
	start)
		/usr/sbin/system-leds work || echo "S39lan: work LED setup failed" >&2

		if [ ! -d /sys/class/net/$DEV ]; then
			echo "S39lan: $DEV not found"
			exit 0
		fi

		if [ "$(cat /sys/class/net/$DEV/address)" != "$MAC" ]; then
			echo "S39lan: setting $DEV MAC to $MAC"
			ip link set $DEV down
			ip link set $DEV address $MAC
		fi
		ip link set $DEV up
		/usr/sbin/system-leds ethernet || echo "S39lan: Ethernet LED setup failed" >&2
		;;
	stop)
		/usr/sbin/system-leds off || { echo "S39lan: LED shutdown failed" >&2; exit 1; }
		;;
	restart|reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
